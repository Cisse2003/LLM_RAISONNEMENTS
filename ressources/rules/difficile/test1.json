{
    "description": "Allumer uniquement le bouton 3",
    "targetState": [0,0,1,0,0,0,0,0,0],
    "difficulty": "difficile",
    "rule": [
        "let tousLesClics = historiques.map(h => h.button);",
        "tousLesClics.push(index + 1);",
        "",
        "buttons.fill(false);",
        "",
        "// Il faut au moins 3 clics pour qu'un bouton s'allume",
        "if (tousLesClics.length >= 3) {",
        "  let troisDerniers = tousLesClics.slice(-3);",
        "",
        "  let produit = troisDerniers[0] * troisDerniers[1] * troisDerniers[2];",
        "",
        "  let numeroBouton = produit % 9;",
        "  if (numeroBouton === 0) numeroBouton = 9;",
        "",
        "  buttons[numeroBouton - 1] = true;",
        "}"
    ]
}