{
  "description": "Allumer uniquement les boutons 6 et 9",
  "targetState": [0,0,0,0,0,1,0,0,1],
  "difficulty": "intermédiaire",
  "validationQuestions": [
    {
      "description": "Si l'état initial est celui-ci et qu'on clique sur le bouton 6, quel sera l'état suivant ?",
      "initialState": [0,0,0,0,0,0,0,0,0],
      "clickButton": 6,
      "expectedState": [0,0,0,0,0,1,1,0,0]
    },
    {
      "description": "Si l'état initial est celui-ci et qu'on clique sur le bouton 3, quel sera l'état suivant ?",
      "initialState": [0,0,0,0,0,1,1,0,0],
      "clickButton": 3,
      "expectedState": [0,0,1,0,0,1,0,0,0]
    },
    {
      "description": "Si l'état initial est celui-ci et qu'on clique sur le bouton 9, quel sera l'état suivant ?",
      "initialState": [0,0,0,0,0,1,1,0,0],
      "clickButton": 9,
      "expectedState": [0,0,0,0,0,1,0,0,1]
    }
  ],
  "rule": [
    "buttons[index] = !buttons[index];",
    "let lie = (index * 3) % 9;",
    "if (lie !== index) buttons[lie] = !buttons[lie];"
  ]
}